<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
	  <LangVersion>preview</LangVersion>
    <AssemblyName>SeasonTTS</AssemblyName>
    <RootNamespace>Season.TTS</RootNamespace>
    <PackageId>SeasonTTS</PackageId>
    <Title>SeasonTTS</Title>
    <Authors>SeasonRealms</Authors>
    <Company>SeasonRealms</Company>
    <Description>SeasonTTS is a .NET text-to-speech library for Qwen3-TTS ONNX bundles, with simple CustomVoice and CloneVoice APIs. It also wraps qwentts.cpp (Qwen3-TTS GGML) via P/Invoke, supports base, CustomVoice, CloneVoice, and VoiceDesign synthesis modes.</Description>
    <PackageTags>tts;onnx;qwen;qwen3-tts;speech;audio;voice-cloning;ggmlvoice-design;cross-platform</PackageTags>
    <PackageProjectUrl>https://github.com/SeasonRealms/SeasonTTS</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SeasonRealms/SeasonTTS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Version>1.2.1</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1572;CS1573</NoWarn>

	  <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst;net10.0;net10.0-browser</TargetFrameworks>
	  <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

	  <IsAndroid Condition="$(TargetFramework.Contains('android'))">true</IsAndroid>
	  <IsIOS Condition="$(TargetFramework.Contains('ios'))">true</IsIOS>
	  <IsMacCatalyst Condition="$(TargetFramework.Contains('maccatalyst'))">true</IsMacCatalyst>
	  <IsWindows Condition="$(TargetFramework.Contains('windows'))">true</IsWindows>

	  <IsLinux Condition="'$(TargetFramework)' == 'net10.0'">true</IsLinux>
	  <IsBrowser Condition="$(TargetFramework.Contains('browser'))">true</IsBrowser>

	  <IsApple Condition="'$(IsIOS)' == 'true' or '$(IsMacCatalyst)' == 'true'">true</IsApple>
	  <IsUnixLike Condition="'$(IsAndroid)' == 'true' or '$(IsLinux)' == 'true'">true</IsUnixLike>

	  <SupportedOSPlatformVersion Condition="'$(IsIOS)' == 'true'">15.0</SupportedOSPlatformVersion>
	  <SupportedOSPlatformVersion Condition="'$(IsMacCatalyst)' == 'true'">15.0</SupportedOSPlatformVersion>
	  <SupportedOSPlatformVersion Condition="'$(IsAndroid)' == 'true'">29.0</SupportedOSPlatformVersion>
	  <SupportedOSPlatformVersion Condition="'$(IsWindows)' == 'true'">10.0.17763.0</SupportedOSPlatformVersion>
	  <TargetPlatformMinVersion Condition="'$(IsWindows)' == 'true'">10.0.17763.0</TargetPlatformMinVersion>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
	<PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.26.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
	  <None Include="README.md" Pack="true" PackagePath="\" />
	  <None Include="LICENSE" Pack="true" PackagePath="\" />
	  <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />

	  <None Include="runtimes\win-x64\native\*" Pack="true" PackagePath="runtimes/win-x64/native/" Condition="Exists('runtimes\win-x64\native')" />
	  <None Include="runtimes\maccatalyst-arm64\native\*" Pack="true" PackagePath="runtimes/maccatalyst-arm64/native/" Condition="Exists('runtimes\maccatalyst-arm64\native')" />
	  <None Include="runtimes\linux-x64\native\*" Exclude="runtimes\linux-x64\native\*.h;runtimes\linux-x64\native\*.txt" Pack="true" PackagePath="runtimes/linux-x64/native/" Condition="Exists('runtimes\linux-x64\native')" />

	  <!--
	    iOS ships a static libqwen.xcframework (ios-arm64 device + ios-arm64-simulator
	    slices, built by build-qwentts.yml). Unlike the Mac Catalyst dylib it is LINKED
	    into the consuming app (QwenNative.cs declares the P/Invokes as "__Internal" on
	    iOS), never copied into the bundle, so there is deliberately no Content item for
	    it here; the app project wires the NativeReference (see SeasonStudio.csproj).
	    The ** glob keeps the xcframework directory layout inside the NuGet package.
	  -->
	  <None Include="runtimes\ios-arm64\native\**" Pack="true" PackagePath="runtimes/ios-arm64/native/%(RecursiveDir)%(Filename)%(Extension)" Condition="Exists('runtimes\ios-arm64\native')" />

	  <ProjectReference Include="..\SeasonGGML\SeasonGGML.csproj" />
  </ItemGroup>

	<!--
	  Android 目标：剔除 AutoImport 误纳的桌面 native 库。Android SDK 的
	  Sdk\AutoImport.props 会把项目目录下所有 **\*.so 自动导入为
	  AndroidNativeLibrary；本项目是 NuGet 式 runtimes\<rid>\native\ 布局，
	  linux-x64 桌面 .so（只服务于 net10.0 目标的 P/Invoke）被一并吸纳，
	  而 Android 类库构建的 AAR 打包（_CreateAar → CreateAar）会对每个
	  native lib 做 ABI 判定，非 Android RID 的路径无法判定并报 XA4301。
	  将来若需向 Android 提供 native 库，应在下方 Remove 之后显式 Include
	  （参考 Season 项目 Platforms\Android\libs\<abi> 的布局）。
	-->
	<ItemGroup Condition="'$(IsAndroid)' == 'true'">
		<AndroidNativeLibrary Remove="runtimes\**\*.so" />
	</ItemGroup>

	<!-- Windows: copy DLLs directly to output root (next to the .exe/.dll) -->
	<ItemGroup Condition="'$(IsWindows)' == 'true'">
		<Content Include="runtimes\win-x64\native\*" Condition="Exists('runtimes\win-x64\native')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>%(Filename)%(Extension)</Link>
			<Pack>true</Pack>
			<PackagePath>runtimes/%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
		</Content>
	</ItemGroup>

	<!--
	  Linux: copy the shared objects directly to output root (next to the managed
	  dll). Only the .so files travel: the folder also holds .h/.txt (ABI reference
	  and license material) which have no place in a deployed .NET app - and would
	  collide, since every AI package ships its own README.txt/ggml.txt.
	-->
	<ItemGroup Condition="'$(IsLinux)' == 'true'">
		<Content Include="runtimes\linux-x64\native\*" Exclude="runtimes\linux-x64\native\*.h;runtimes\linux-x64\native\*.txt" Condition="Exists('runtimes\linux-x64\native')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>%(Filename)%(Extension)</Link>
			<Pack>false</Pack>
		</Content>
	</ItemGroup>

	<!--
	  Mac Catalyst: the Qwen TTS GGML runtime is merged into a single self-contained
	  libqwen.dylib (ggml is statically linked in, see otool -L: no libggml dependency).
	  QwenNative.cs P/Invokes "libqwen" on this platform, so the dylib must be shipped
	  in the app bundle; the Apple SDK classifies it as a dynamic library and places it
	  under Contents/MonoBundle where the runtime resolves it.
	  Only the dylib itself is Content: the folder also holds qwen.h, qwentts.txt,
	  ggml.txt and README.txt, which have no place in an app bundle (and the Apple SDK
	  warns it cannot compute a PublishFolderType for them).
	-->
	<ItemGroup Condition="'$(IsMacCatalyst)' == 'true'">
		<Content Include="runtimes\maccatalyst-arm64\native\libqwen.dylib" Condition="Exists('runtimes\maccatalyst-arm64\native\libqwen.dylib')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>%(Filename)%(Extension)</Link>
			<Pack>false</Pack>
		</Content>
	</ItemGroup>

</Project>
